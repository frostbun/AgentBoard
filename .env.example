# herdr connection -----------------------------------------------------------
# Everything below is optional: when unset, AgentBoard discovers the socket.
#
# Explicit socket (wins over everything else). herdr injects HERDR_SOCKET_PATH
# into processes it launches, so running the board from inside a herdr pane
# needs no configuration at all.
# HERDR_SOCKET_PATH=/home/you/.config/herdr/sessions/agentboard/herdr.sock

# Named herdr session to attach to (default: newest running session).
# HERDR_SESSION=agentboard

# herdr config dir (default: ~/.config/herdr)
# HERDR_CONFIG_DIR=/home/you/.config/herdr

# Serving --------------------------------------------------------------------
# HOST defaults to 0.0.0.0 so your phone can reach the board.
# PORT=4317

# Access control. Without a token AgentBoard generates one per run and prints the
# ready-to-tap URL (with token) on the first request.
# AGENTBOARD_TOKEN=...   # pin a stable token (recommended for scripted access)
# AGENTBOARD_OPEN=1      # disable the check entirely — trusted networks only
